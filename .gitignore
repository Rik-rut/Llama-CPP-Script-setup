# Folder structure is tracked via .gitkeep; contents are machine-local.
# (Put .gguf files in models/, engine build in engine/, runtime output in logs/)
*.gguf
models/*
!models/.gitkeep
engine/*
!engine/.gitkeep
logs/*
!logs/.gitkeep
*.zip

# Local env (per-machine settings — copy .env.example to .env)
.env
.port

# Runtime artifacts (logs/ structure tracked via .gitkeep)
*.log
*.err.log

# Backups
*.bak-*
llama.cpp.bak-*/

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store

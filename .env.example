# llama.cpp local server config — copy to .env and adjust per machine.
# Fixed uncommon port to avoid 8080 conflicts. Override with PORT= env or 2nd CLI arg.
PORT=18123
# Default localhost-only (Cloudflare Tunnel on same PC works via 127.0.0.1).
# Set to 0.0.0.0 only if you need other LAN devices to reach the server.
HOST=127.0.0.1
# Pinned engine version for reproducible setup.bat/sh downloads.
ENGINE_VERSION=b10740
ENGINE_DIR=engine\llama.cpp-b10740
MODEL_DIR=models
# Optional: set to require an API key (recommended if exposing via tunnel).
# Server flag: --api-key <value>. Clients then send Authorization: Bearer <value>.
# Leave empty for local-only use.
LLAMA_API_KEY=
# Cloudflared example (run separately, no firewall inbound needed):
# cloudflared tunnel --url http://127.0.0.1:18123
# Or named tunnel ingress: hostname: llm.example.com -> service: http://127.0.0.1:18123
